# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# API
API_PORT=3001
NODE_ENV=development
WEB_ORIGIN="http://localhost:3000"
API_URL="http://localhost:3001"
LOG_LEVEL=info
REQUIRE_EMAIL_VERIFICATION=false
# When unset: required in production, optional otherwise.
# Onboarding + recommendations return 403 EMAIL_NOT_VERIFIED until verify-email succeeds.

# Auth
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
COOKIE_SECRET="replace-with-a-long-random-cookie-secret"

# Media providers: mock | live
MEDIA_PROVIDER_MODE=mock
TMDB_API_KEY=""
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""
LASTFM_API_KEY=""

# AI
AI_MOCK=true
OPENAI_API_KEY=""
AI_RERANK_MODEL="gpt-4o-mini"
AI_EXPLANATION_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# Email (optional — console mailer is used when empty)
RESEND_API_KEY=""
EMAIL_FROM="Genie <noreply@localhost>"

# Frontend (browser-safe: same-origin proxy in production)
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
