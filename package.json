{
  "name": "recommendation-genie",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"pnpm --filter @recommendation-genie/web dev\" \"pnpm --filter @recommendation-genie/api start:dev\"",
    "build": "pnpm --filter @recommendation-genie/prisma build && pnpm --filter @recommendation-genie/types build && pnpm --filter @recommendation-genie/web build && pnpm --filter @recommendation-genie/api build",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @recommendation-genie/web test:e2e && pnpm --filter @recommendation-genie/api test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @recommendation-genie/prisma generate",
    "db:migrate": "pnpm --filter @recommendation-genie/prisma migrate:dev",
    "db:migrate:deploy": "pnpm --filter @recommendation-genie/prisma migrate:deploy",
    "db:seed": "pnpm --filter @recommendation-genie/prisma seed",
    "db:studio": "pnpm --filter @recommendation-genie/prisma studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["argon2", "prisma", "@prisma/client", "@prisma/engines"]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
